# Backend Environment Variables
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/codeforge_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache
REDIS_URL=redis://:redis_password@localhost:6379
REDIS_TTL=300

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRATION=30d

# OAuth 2.0 - Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth 2.0 - Apple Sign-In
APPLE_CLIENT_ID=com.codeforgeai.app
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=./keys/apple_private_key.p8
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# AI Provider - OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORG_ID=org-your_org_id (optional)
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# AI Provider - Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKey\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Cloud Storage - Google Cloud Storage
GCS_BUCKET_NAME=codeforge-dev-files
GCS_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./keys/gcp-service-account.json

# Cloud Storage - AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=codeforge-dev-files

# Email Service (SendGrid example)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@codeforgeai.app
EMAIL_FROM_NAME=CodeForge AI

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS_FREE=10
RATE_LIMIT_MAX_REQUESTS_PRO=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Monitoring - Sentry
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Monitoring - Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Session
SESSION_SECRET=your_session_secret_change_this

# Webhook Secrets
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Feature Flags
FEATURE_VOICE_MODE=true
FEATURE_CLOUD_SYNC=true
FEATURE_OFFLINE_MODE=true

# Admin
ADMIN_EMAIL=admin@codeforgeai.app
