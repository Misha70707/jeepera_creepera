rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MARK: - Helper Functions

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(roles) {
      return isAuthenticated() && request.auth.token.role in roles;
    }

    // MARK: - Users Collection

    match /users/{userId} {
      // Users can read/write their own document
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Allow creating own user document during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // MARK: - Routines Collection

    match /routines/{routineId} {
      // Authenticated users can create routines
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Users can read/write their own routines
      allow read, write: if isAuthenticated() &&
                           request.resource.data.userId == request.auth.uid;
    }

    // MARK: - Posts Collection

    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;

      // Authenticated users can create posts
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid;

      // Users can update their own posts
      allow update: if isAuthenticated() &&
                       resource.data.authorId == request.auth.uid;

      // Users can delete their own posts
      allow delete: if isAuthenticated() &&
                       resource.data.authorId == request.auth.uid;
    }

    // MARK: - Tribes Collection

    match /tribes/{tribeId} {
      // Anyone can read tribes
      allow read: if true;

      // Only admins can write to tribes
      allow write: if hasRole(['admin']);
    }

    // MARK: - Achievements Collection

    match /achievements/{achievementId} {
      // Users can read achievements
      allow read: if true;

      // Only cloud functions can write achievements
      allow write: if false;
    }

    // MARK: - Leaderboard Collection

    match /leaderboard/{leaderboardId} {
      // Anyone can read leaderboard
      allow read: if true;

      // Only cloud functions can write leaderboard
      allow write: if false;
    }

    // MARK: - Deny All by Default

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
